.wrap {
  padding: 24rpx 0 60rpx;
}

/* 进度条 */
.steps {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 10rpx;
}
.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.35;
}
.step.reached { opacity: 1; }
.step-dot {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #F5EFE9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}
.step.reached .step-dot { background: #FFE9DD; }
.step.current .step-dot {
  background: #FF8A5C;
  box-shadow: 0 6rpx 16rpx rgba(255, 138, 92, 0.4);
}
.step-label {
  font-size: 22rpx;
  margin-top: 12rpx;
  color: #8A7A6E;
}
.step.current .step-label {
  color: #FF8A5C;
  font-weight: 700;
}

.cancelled-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  color: #A99A8C;
  font-size: 28rpx;
}
.cancelled-emoji {
  font-size: 40rpx;
  margin-right: 16rpx;
}

/* 菜品明细（与结算页同款样式） */
.section-title {
  font-size: 26rpx;
  color: #8A7A6E;
  margin-bottom: 20rpx;
  font-weight: 600;
}
.item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.item-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #F5EFE9;
  flex-shrink: 0;
}
.item-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.item-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.item-count {
  font-size: 26rpx;
  color: #A99A8C;
  margin-right: 24rpx;
}
.item-price { font-size: 28rpx; }

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx solid #F7F1EA;
  margin-top: 12rpx;
  padding-top: 24rpx;
  font-weight: 700;
  font-size: 28rpx;
}
.total-num { font-size: 36rpx; }

.info-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}
.info-label {
  width: 150rpx;
  color: #A99A8C;
  flex-shrink: 0;
}
.info-value { flex: 1; }

.ops {
  padding: 0 24rpx;
}
.ops .btn-ghost.cancel {
  color: #A99A8C;
  border-color: #E0D5CA;
}
