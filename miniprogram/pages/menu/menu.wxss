.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 主厨工具条 */
.chef-bar {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 20rpx;
}
.chef-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  background: #FFFFFF;
  color: #FF8A5C;
  border: 2rpx solid #FFD9C4;
}
.chef-btn.main {
  background: #FF8A5C;
  color: #FFFFFF;
  border-color: #FF8A5C;
  font-weight: 600;
}

/* 左右布局 */
.menu-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.cat-side {
  width: 170rpx;
  flex-shrink: 0;
  height: 100%;
}
.cat-item {
  padding: 30rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8A7A6E;
  position: relative;
}
.cat-item.active {
  background: #FFFFFF;
  color: #FF8A5C;
  font-weight: 700;
  border-radius: 24rpx 0 0 24rpx;
}
.cat-item.active::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: #FF8A5C;
}

.dish-list {
  flex: 1;
  height: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 0 0 0;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 菜品卡片 */
.dish-card {
  display: flex;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #FFFBF7;
  margin-bottom: 20rpx;
}
.dish-card.off {
  opacity: 0.65;
}
.dish-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #F5EFE9;
}
.dish-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.dish-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.dish-name {
  font-size: 30rpx;
  font-weight: 700;
}
.off-tag {
  font-size: 20rpx;
  color: #A99A8C;
  background: #F0EBE6;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  font-weight: 400;
}
.dish-desc {
  font-size: 22rpx;
  color: #A99A8C;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.dish-bottom {
  margin-top: auto;
  padding-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dish-price {
  font-size: 28rpx;
}

/* 加减步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
}
.step-btn.plus {
  background: #FF8A5C;
  color: #FFFFFF;
}
.step-btn.minus {
  background: #FFF1E8;
  color: #FF8A5C;
}
.step-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
}

/* 主厨管理按钮行 */
.dish-manage {
  margin-top: 14rpx;
  display: flex;
}
.dish-manage .btn-mini {
  margin-left: 0;
  margin-right: 14rpx;
}

.list-pad {
  height: 160rpx;
}

/* 底部购物车栏 */
.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 104rpx;
  background: #5C4A3D;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(92, 74, 61, 0.35);
  z-index: 10;
}
.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
}
.cart-icon {
  font-size: 44rpx;
  position: relative;
  margin-right: 20rpx;
}
.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  background: #FF5A5A;
  color: #FFF;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}
.cart-total .coin {
  font-size: 34rpx;
}
.cart-empty-text {
  color: #B8A99A;
  font-size: 26rpx;
}
.cart-go {
  height: 104rpx;
  padding: 0 52rpx;
  border-radius: 999rpx;
  background: #FF8A5C;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}
.cart-go.disabled {
  background: #8A7A6E;
  color: #C4B7AA;
}
